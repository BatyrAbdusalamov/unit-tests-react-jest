{
  "printWidth": 85,
  "arrowParens": "avoid",
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "endOfLine": "auto",
  "importOrderSeparation": true,
  "importOrder": [
    "<THIRD_PARTY_MODULES>",
    "interface",
    "(?=content|api)",
    "(components/|./index)",
    ".svg",
    "^../(.*)$",
    "(?=./styles.module.scss)"
  ]
}
